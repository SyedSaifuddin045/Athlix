# =============================================================================
# Athlix — Production environment variables (for Coolify Docker Compose deploy)
# =============================================================================
# Copy these into Coolify's environment variable UI for the app service.
# Required vars (no default) must be set before the container will start.
# =============================================================================

# --- Database (use your Coolify-managed PostgreSQL service credentials) ---
DATABASE_HOST=postgres.internal
DATABASE_PORT=5432
DATABASE_NAME=athlix
DATABASE_USER=athlix
DATABASE_PASSWORD=replace-with-strong-password

# --- Domain (for Traefik proxy / SSL) ---
DOMAIN=api.athlix.app

# --- Authentication (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=replace-with-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-at-least-32-characters

# --- CORS (list the origins that will call this API) ---
CORS_ALLOWED_ORIGINS=["https://athlix.app","https://www.athlix.app"]

# --- Optional overrides (these have sensible defaults) ---
# APP_PORT=8050
# APP_NAME=Athlix API
# APP_VERSION=1.0.0
# DEBUG=false
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOWED_METHODS=["*"]
# CORS_ALLOWED_HEADERS=["*"]
